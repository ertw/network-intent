check : (List Nat,List (Nat,Nat),Bool) -> (Bool,Bool)
check (vertices,edges,expected) = case certifyDAG vertices edges of
 Right cert => (expected,certificateOK vertices edges cert.order)
 Left (DirectedCycle witness) => (not expected,validWitness edges witness.path)
 Left (InvalidGraph _) => (False,False)

main : IO ()
main = do
 let results = map check cases
