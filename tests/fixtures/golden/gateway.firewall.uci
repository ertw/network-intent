config defaults 'net_defaults'
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'DROP'
	option synflood_protect '1'

config zone 'zone_v10'
	option name 'v10'
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'DROP'
	list network 'v10'

config zone 'zone_v20'
	option name 'v20'
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'DROP'
	list network 'v20'

config zone 'zone_v30'
	option name 'v30'
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'DROP'
	list network 'v30'

config zone 'net_wan'
	option name 'wan'
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'DROP'
	list network 'wan'

config rule 'dhcp_v10'
	option name 'DHCP trusted'
	option src 'v10'
	option proto 'udp'
	option dest_port '67'
	option family 'ipv4'
	option target 'ACCEPT'

config rule 'dhcp_dns_v10'
	option name 'DHCP DNS trusted'
	option src 'v10'
	option proto 'tcp udp'
	option dest_port '53'
	option family 'ipv4'
	option target 'ACCEPT'

config rule 'dhcp_v30'
	option name 'DHCP iot'
	option src 'v30'
	option proto 'udp'
	option dest_port '67'
	option family 'ipv4'
	option target 'ACCEPT'

config rule 'dhcp_dns_v30'
	option name 'DHCP DNS iot'
	option src 'v30'
	option proto 'tcp udp'
	option dest_port '53'
	option family 'ipv4'
	option target 'ACCEPT'

config rule 'policy_0'
	option src 'v10'
	option family 'ipv4'
	option target 'ACCEPT'
	option dest 'wan'
	option proto 'all'

config rule 'policy_1'
	option src 'v10'
	option family 'ipv4'
	option target 'ACCEPT'
	option dest 'v20'
	option proto 'all'

config rule 'policy_2'
	option src 'v30'
	option family 'ipv4'
	option target 'ACCEPT'
	option dest 'wan'
	option proto 'all'

config rule 'policy_3_0_0'
	option src 'v30'
	option family 'ipv4'
	option target 'ACCEPT'
	option proto 'udp'
	option dest_port '53'

config rule 'policy_3_0_1'
	option src 'v30'
	option family 'ipv4'
	option target 'ACCEPT'
	option proto 'tcp'
	option dest_port '53'

config rule 'policy_3_1_0'
	option src 'v30'
	option family 'ipv4'
	option target 'ACCEPT'
	option proto 'udp'
	option dest_port '123'

config rule 'policy_4'
	option src 'v30'
	option family 'ipv4'
	option target 'DROP'
	option dest 'v10'
	option proto 'all'

config rule 'policy_5'
	option src 'v30'
	option family 'ipv4'
	option target 'DROP'
	option dest 'v20'
	option proto 'all'

